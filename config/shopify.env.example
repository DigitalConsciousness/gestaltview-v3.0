# Server-only Shopify connection. Never prefix these values with VITE_.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-headless-storefront-token

# Phase 1 public catalog switch. Safe fallback remains available when false.
STOREFRONT_PUBLIC_ENABLED=false

# Keep false until Phase 2 checkout, webhook, fulfillment, and refund gates pass.
STOREFRONT_CHECKOUT_ENABLED=false

# Webhook HMAC secret. Configure only in the primary GestaltView server runtime;
# never expose it through VITE_ or NEXT_PUBLIC_.
SHOPIFY_APP_CLIENT_SECRET=replace-with-connected-app-client-secret

# The standalone storefront needs this primary-runtime origin for server-side
# activation receipt lookup. Add its origin to CORS_ORIGINS only if a future
# browser client calls the primary API directly.
GESTALTVIEW_APP_URL=https://gestaltview-di-gsvw.vercel.app
