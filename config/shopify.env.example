# Server-only Shopify connection. Never prefix these values with VITE_.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-headless-storefront-token

# Phase 1 public catalog switch. Safe fallback remains available when false.
STOREFRONT_PUBLIC_ENABLED=false

# Keep false until Phase 2 checkout, webhook, fulfillment, and refund gates pass.
STOREFRONT_CHECKOUT_ENABLED=false

# Reserved for Phase 2. Do not configure in browser-visible environment.
SHOPIFY_APP_CLIENT_SECRET=replace-during-phase-2
