{
  // ══════════════════════════════════════════════════════════════════════════
  // GestaltView ✦ Founder's Edition — VS Code Settings
  // Neon lettering · Deep navy background · Optimized for phone + Codespaces
  // ══════════════════════════════════════════════════════════════════════════

  // ─── Theme: Tokyo Night — deep navy/dark-blue background ─────────────────
  "workbench.colorTheme": "Joker Neon",
  "workbench.iconTheme": "vs-seti",
  "workbench.productIconTheme": "material-product-icons",

  // ─── Neon color token overrides ──────────────────────────────────────────
  "editor.tokenColorCustomizations": {
    "[Tokyo Night]": {
      "textMateRules": [
        {
          "scope": ["keyword", "keyword.control", "keyword.operator"],
          "settings": { "foreground": "#FF6BF5", "fontStyle": "bold" }
        },
        {
          "scope": ["entity.name.function", "support.function"],
          "settings": { "foreground": "#00FFC8", "fontStyle": "bold" }
        },
        {
          "scope": ["entity.name.type", "entity.name.class", "support.class"],
          "settings": { "foreground": "#FFD700", "fontStyle": "bold" }
        },
        {
          "scope": ["variable", "variable.other"],
          "settings": { "foreground": "#C8B9FF" }
        },
        {
          "scope": ["string", "string.quoted"],
          "settings": { "foreground": "#A8FF78" }
        },
        {
          "scope": ["comment", "comment.line", "comment.block"],
          "settings": { "foreground": "#4A5280", "fontStyle": "italic" }
        },
        {
          "scope": ["constant.numeric", "constant.language"],
          "settings": { "foreground": "#FF9F6B" }
        },
        {
          "scope": ["entity.name.tag", "punctuation.definition.tag"],
          "settings": { "foreground": "#FF6B9D" }
        },
        {
          "scope": ["support.type.property-name", "meta.object-literal.key"],
          "settings": { "foreground": "#79C5FF" }
        },
        {
          "scope": [
            "meta.import",
            "keyword.control.import",
            "keyword.control.from"
          ],
          "settings": { "foreground": "#FF6BF5", "fontStyle": "italic" }
        }
      ]
    }
  },

  // ─── Workbench color overrides (deep navy UI chrome) ─────────────────────
  "workbench.colorCustomizations": {
    "[Tokyo Night]": {
      "editor.background": "#0A0E1A",
      "editorGutter.background": "#0A0E1A",
      "sideBar.background": "#07091280",
      "activityBar.background": "#050710",
      "titleBar.activeBackground": "#050710",
      "titleBar.activeForeground": "#C8B9FF",
      "statusBar.background": "#0D1240",
      "statusBar.foreground": "#00FFC8",
      "terminal.background": "#050710",
      "panel.background": "#07091280",
      "tab.activeBackground": "#0A0E1A",
      "tab.inactiveBackground": "#07091280",
      "tab.activeBorderTop": "#FF6BF5",
      "editorLineNumber.foreground": "#2A3060",
      "editorLineNumber.activeForeground": "#7B6FFF",
      "editor.lineHighlightBackground": "#111830",
      "editor.selectionBackground": "#2A2070",
      "editor.findMatchBackground": "#FF6BF540",
      "editorBracketHighlight.foreground1": "#FF6BF5",
      "editorBracketHighlight.foreground2": "#00FFC8",
      "editorBracketHighlight.foreground3": "#FFD700",
      "scrollbarSlider.background": "#1A2040",
      "scrollbarSlider.hoverBackground": "#2A3060"
    }
  },

  // ─── Font: JetBrains Mono (neon-friendly monospace) ─────────────────────
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.7,
  "editor.letterSpacing": 0.3,
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,

  // ─── Editor quality-of-life ───────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.cursorBlinking": "phase",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": true,
  "editor.scrollBeyondLastLine": false,
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.insertMode": "replace",
  "editor.quickSuggestionsDelay": 50,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,

  // ─── Markdown: enhanced preview ───────────────────────────────────────────
  "markdown.preview.fontSize": 15,
  "markdown.preview.lineHeight": 1.8,
  "markdown.preview.fontFamily": "'JetBrains Mono', monospace",
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  "markdown-preview-enhanced.previewTheme": "one-dark.css",
  "markdown-preview-enhanced.codeBlockTheme": "funky.css",
  "markdown-preview-enhanced.enableHTML": true,

  // ─── Python ──────────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "/usr/local/bin/python3",
  "python.formatting.provider": "none",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "isort.args": ["--profile", "black"],

  // ─── TypeScript / JavaScript ──────────────────────────────────────────────
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": false,

  // ─── Tailwind ────────────────────────────────────────────────────────────
  "tailwindCSS.includeLanguages": {
    "typescript": "html",
    "typescriptreact": "html"
  },
  "tailwindCSS.experimental.classRegex": [["cn\\(([^)]*)\\)", "'([^']*)'"]],

  // ─── Terminal ────────────────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.scrollback": 5000,
  "terminal.integrated.copyOnSelection": true,

  // ─── Git ─────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.currentLine.enabled": true,

  // ─── File associations ────────────────────────────────────────────────────
  "files.associations": {
    "*.env*": "dotenv",
    "*.mdx": "markdown"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/dist": true
  },

  // ─── Explorer ────────────────────────────────────────────────────────────
  "explorer.compactFolders": false,
  "workbench.tree.indent": 16,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.test.ts",
    "*.tsx": "${capture}.css, ${capture}.module.css, ${capture}.test.tsx",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc",
    "tailwind.config.*": "postcss.config.*",
    ".env": ".env.*, .env.example"
  },

  // ─── Error Lens ───────────────────────────────────────────────────────────
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.fontSize": "12",
  "errorLens.fontStyle": "italic",

  // ─── TODO Highlight ───────────────────────────────────────────────────────
  "todohighlight.keywords": [
    { "text": "TODO:", "color": "#FFD700", "backgroundColor": "transparent" },
    { "text": "FIXME:", "color": "#FF6B9D", "backgroundColor": "transparent" },
    {
      "text": "KEITH:",
      "color": "#00FFC8",
      "backgroundColor": "transparent",
      "fontWeight": "bold"
    },
    {
      "text": "SACRED:",
      "color": "#FF6BF5",
      "backgroundColor": "transparent",
      "fontWeight": "bold"
    }
  ],

  // ─── Peacock (workspace accent color) ────────────────────────────────────
  "peacock.color": "#0D1240",
  "peacock.affectActivityBar": true,
  "peacock.affectStatusBar": true,
  "peacock.affectTitleBar": true,

  // ─── Spell checker ───────────────────────────────────────────────────────
  "cSpell.words": [
    "GestaltView",
    "Soyka",
    "gestalt",
    "tapestry",
    "heirloom",
    "neurodivergent",
    "symbiosis",
    "ollama",
    "fastapi",
    "supabase",
    "codespace",
    "devcontainer",
    "lucide",
    "tailwindcss",
    "wouter"
  ],
  "editor.autoIndentOnPaste": true,
  "workbench.preferredDarkColorTheme": "Joker Neon",
  "workbench.preferredHighContrastColorTheme": "Joker Neon",
  "workbench.preferredHighContrastLightColorTheme": "Joker Neon",
  "workbench.preferredLightColorTheme": "Joker Neon",
  "workbench.editor.alwaysShowEditorActions": true,
  "workbench.editor.autoLockGroups": {
    "jupyter-notebook": true,
    "imagePreview.previewEditor": true,
    "vscode.audioPreview": true,
    "vscode.videoPreview": true,
    "zipViewer.ZipEdit": true,
    "zipViewer.GZipEdit": true,
    "workbench.input.interactive": true,
    "mainThreadWebview-markdown.preview": true
  },
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "window.autoDetectColorScheme": true,
  "markdown-preview-enhanced.automaticallyShowPreviewOfMarkdownBeingEdited": true,
  "chat.mcp.serverSampling": {
    "gestaltview-v2.0/.vscode/mcp.json: supabase": {
      "allowedModels": [
        "copilotcli/auto",
        "copilot/auto"
      ]
    },
    "gestaltview-v3.0/.vscode/mcp.json: com.supabase/mcp": {
      "allowedModels": [
        "copilotcli/auto",
        "copilot/auto"
      ]
    }
  },
  "markdown.validate.enabled": true
}
