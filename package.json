    "continuity:check": "node scripts/validate-continuity-stack.mjs",
    "meticulous:routes": "node scripts/validate-meticulous-route-coverage.mjs",
    "billycheck": "npx tsx tools/billycheck.ts",
    "ingest": "python3 scripts/ingest_corpus.py",
    "ingest:agent-trainer": "python3 scripts/ingest_agent_trainer_corpus.py",
    "temporal:backfill": "python3 scripts/temporal_backfill.py",
    "seed": "python3 scripts/seed_billy_knowledge.py",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "migrate": "python3 scripts/run_migration.py",
    "manifest": "python3 scripts/generate_repo_manifest.py",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:verify": "psql \"$DATABASE_URL\" -f prisma/verification/verify_expected_columns.sql",
    "sync:perplexity": "node scripts/sync-perplexity-collaboration.mjs",
    "sync:perplexity:check": "node scripts/sync-perplexity-collaboration.mjs --check",
    "bugwalk:new": "bash scripts/new-bugwalk.sh",
    "bugwalk:close": "bash scripts/bugwalk-closeout.sh",
    "ollama:pull": "bash .devcontainer/ollama-pull.sh",
    "ollama:list": "ollama list",
    "generate:embodiment": "node scripts/build-embodiment-artifacts.mjs",
    "validate:embodiment": "node scripts/validate-embodiment-profiles.mjs",
    "di:enrich": "DI_ENRICHMENT_APPROVED=true node scripts/enrich-living-memories.mjs",
    "package:collaborator": "node scripts/package-collaborator-bundle.mjs",
    "supabase:dump:zip": "node scripts/supabase-db-dump-zip.mjs",
    "disk": "df -h / && ncdu / --exclude /proc -x -q 2>/dev/null || df -h /",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:full-report": "bash scripts/run-comprehensive-tests.sh",
    "embodiments:check-generated": "node scripts/build-embodiment-artifacts.mjs --check",
    "operation-render:validate": "node scripts/validate-operation-render-sweep.mjs"
  },
