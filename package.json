  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node --import tsx server/index.ts",
    "setup:python": "python3 -m pip install -r requirements.txt",
    "codex:env": "bash scripts/codex-env.sh",
    "hotfix:env": "bash scripts/codex-env.sh node scripts/check-hotfix-env.mjs",
    "auth:hash": "node scripts/hash-admin-password.mjs",
    "agent-trainer": "bash agent_trainer.sh",
    "agent-trainer:setup": "bash agent_trainer.sh setup",
    "agent-trainer:status": "bash agent_trainer.sh status",
    "agent-trainer:test": "bash agent_trainer.sh test",
    "trainer:worker": "tsx worker/trainer/main.ts",
    "embodiments:build": "node scripts/build-embodiment-artifacts.mjs",
    "embodiments:docs": "python3 embodiment_profiles/embodiment_profile_content.py",
    "embodiments:render-billy": "node scripts/render-billy-personality.mjs",
    "sync-profiles": "node --import tsx scripts/sync-embodiment-profiles.ts",
