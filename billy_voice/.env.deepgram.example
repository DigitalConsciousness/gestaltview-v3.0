# Required
DEEPGRAM_API_KEY=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# GestaltView text/orchestration API
BILLY_API_URL=http://localhost:3000
VOICE_TEXT_API_PATH=/api/billy

# Profile routing
VOICE_PROFILE_SLUG=billy
VOICE_PROFILE_REGISTRY=config/deepgram_voice_profiles.json
BILLY_MODE=chat

# Deepgram defaults (profile values override these)
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=24000
DEEPGRAM_TIMEOUT_SECONDS=45

# Optional: log request metadata through a server endpoint
VOICE_AUDIT_API_PATH=
