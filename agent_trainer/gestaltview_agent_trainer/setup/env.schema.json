{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GestaltView Agent Trainer Environment",
  "type": "object",
  "properties": {
    "NEXT_PUBLIC_SUPABASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "type": "string",
      "minLength": 1
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "type": "string",
      "minLength": 1
    },
    "GROQ_API_KEY": {
      "type": "string"
    },
    "OPENAI_API_KEY": {
      "type": "string"
    },
    "GEMINI_API_KEY": {
      "type": "string"
    },
    "EMBEDDING_PROVIDER": {
      "type": "string",
      "enum": [
        "gemini",
        "openai"
      ]
    },
    "EMBEDDING_MODEL": {
      "type": "string",
      "minLength": 1
    },
    "EMBEDDING_DIMENSION": {
      "type": "string",
      "enum": [
        "768",
        "1536"
      ]
    },
    "KIT_NAME": {
      "type": "string",
      "minLength": 1
    },
    "KIT_DOMAIN": {
      "type": "string",
      "enum": [
        "general",
        "resume",
        "adhd",
        "creative",
        "consulting",
        "custom"
      ]
    },
    "KIT_TIER": {
      "type": "string",
      "enum": [
        "SOLO_SPARK",
        "STUDIO",
        "GROWTH",
        "ENTERPRISE"
      ]
    },
    "KIT_PRIMARY_COLOR": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "VOICE_INPUT_PROVIDER": {
      "type": "string"
    },
    "VOICE_OUTPUT_PROVIDER": {
      "type": "string"
    },
    "VOICE_CAPTURE_MODE": {
      "type": "string",
      "enum": [
        "browser",
        "webrtc",
        "telephony"
      ]
    },
    "VOICE_TRANSCRIPT_BUCKET": {
      "type": "string"
    },
    "VOICE_WEBHOOK_SECRET": {
      "type": "string"
    }
  },
  "required": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "EMBEDDING_PROVIDER",
    "EMBEDDING_MODEL",
    "EMBEDDING_DIMENSION",
    "KIT_NAME",
    "KIT_DOMAIN",
    "KIT_TIER",
    "KIT_PRIMARY_COLOR"
  ]
}
