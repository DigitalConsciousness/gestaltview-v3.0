{
  "version": "1.1.0",
  "defaultTaskOrder": [
    "recommend_segment",
    "create_workspace",
    "stage_corpus_container",
    "connect_supabase",
    "connect_provider",
    "review_sources",
    "import_corpus",
    "choose_lane_focus",
    "select_theme",
    "run_evals",
    "configure_governance",
    "publish_agent"
  ],
  "tracks": {
    "solo": [
      "recommend_segment",
      "create_workspace",
      "stage_corpus_container",
      "connect_provider",
      "review_sources",
      "import_corpus",
      "choose_lane_focus",
      "select_theme",
      "run_evals",
      "publish_agent"
    ],
    "business": [
      "recommend_segment",
      "create_workspace",
      "stage_corpus_container",
      "connect_supabase",
      "connect_provider",
      "review_sources",
      "import_corpus",
      "choose_lane_focus",
      "select_theme",
      "run_evals",
      "publish_agent"
    ],
    "enterprise": [
      "recommend_segment",
      "create_workspace",
      "stage_corpus_container",
      "connect_supabase",
      "connect_provider",
      "review_sources",
      "import_corpus",
      "choose_lane_focus",
      "select_theme",
      "run_evals",
      "configure_governance",
      "publish_agent"
    ]
  },
  "tasks": [
    {
      "task_id": "recommend_segment",
      "title": "Recommend Commercial Lane",
      "description": "Score the buyer profile and recommend Solo, Business, or Enterprise before shaping the rest of onboarding.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": [],
      "inputs": [
        "team_size",
        "needs_compliance",
        "multi_workspace",
        "identity_boundary",
        "source_volume",
        "deployment_preference"
      ],
      "actions": ["score_segment"],
      "outputs": ["segment_recommendation", "segment_score"],
      "failure_modes": ["missing_profile_input"],
      "next": ["create_workspace"]
    },
    {
      "task_id": "create_workspace",
      "title": "Create Workspace and First Agent",
      "description": "Capture the workspace, first agent, and the ownership boundary so the operator knows exactly what is being created.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["recommend_segment"],
      "inputs": ["workspace_name", "agent_name", "owner_email"],
      "actions": ["create_org_scaffold", "create_workspace_scaffold", "seed_agent_scaffold"],
      "outputs": ["organization_status", "workspace_status", "agent_status"],
      "failure_modes": ["missing_workspace_name", "missing_agent_name"],
      "next": ["stage_corpus_container"]
    },
    {
      "task_id": "stage_corpus_container",
      "title": "Create Repo and Corpus Container",
      "description": "Create the GitHub repo container, incoming drop zones, lane folders, and starter manifest before any import runs.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["create_workspace"],
      "inputs": ["repository", "default_branch", "corpus_container", "staging_mode"],
      "actions": ["create_repo_container", "generate_manifest_scaffold", "surface_seed_order"],
      "outputs": ["container_status", "manifest_template", "review_queue_status"],
      "failure_modes": ["repository_missing", "container_missing", "manifest_generation_failed"],
      "next": ["connect_supabase", "connect_provider"]
    },
    {
      "task_id": "connect_supabase",
      "title": "Connect Supabase",
      "description": "Validate the Supabase URL, keys, schema, and storage prerequisites before the first live corpus write.",
      "entry_modes": ["web", "cli"],
      "segments": ["business", "enterprise"],
      "preconditions": ["stage_corpus_container"],
      "inputs": ["project_url", "anon_key", "service_role_key"],
      "actions": ["validate_env", "test_connection", "verify_schema"],
      "outputs": ["connection_status", "schema_status"],
      "failure_modes": ["missing_key", "invalid_url", "schema_missing"],
      "next": ["connect_provider"]
    },
    {
      "task_id": "connect_provider",
      "title": "Connect Provider",
      "description": "Choose the primary text provider chain and verify at least one model is available for guided setup and evaluation.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["stage_corpus_container"],
      "inputs": ["provider", "model", "api_key_present"],
      "actions": ["validate_provider_presence", "select_provider_chain"],
      "outputs": ["provider_status", "provider_chain"],
      "failure_modes": ["provider_missing", "model_unavailable"],
      "next": ["review_sources"]
    },
    {
      "task_id": "review_sources",
      "title": "Review and Batch Sources",
      "description": "Classify sources into knowledge, code, product, or context, flag risky files, and plan a small first seed batch.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["connect_provider"],
      "inputs": [
        "review_mode",
        "source_count",
        "batch_count",
        "lane_assignments",
        "oversized_source_count"
      ],
      "actions": ["classify_sources", "flag_risky_sources", "build_seed_plan"],
      "outputs": ["review_status", "seed_plan", "safe_import_order"],
      "failure_modes": ["empty_review_queue", "source_batch_missing", "oversized_sources_detected"],
      "next": ["import_corpus"]
    },
    {
      "task_id": "import_corpus",
      "title": "Import Corpus",
      "description": "Ingest the reviewed first batch and capture lane coverage, duplicate posture, and the next recommended batch.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["review_sources"],
      "inputs": ["import_mode", "manifest_path", "source_count", "lane_assignments", "batch_count"],
      "actions": ["validate_sources", "ingest_sources", "capture_ingestion_metrics"],
      "outputs": ["ingestion_status", "lane_coverage", "duplicate_report"],
      "failure_modes": ["manifest_missing", "ingestion_failed", "empty_corpus"],
      "next": ["choose_lane_focus"]
    },
    {
      "task_id": "choose_lane_focus",
      "title": "Choose Lane Focus",
      "description": "Declare the first lane that should be made production-ready and show its next best action.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["import_corpus"],
      "inputs": ["lane_focus"],
      "actions": ["score_lane_readiness", "recommend_next_action"],
      "outputs": ["lane_status", "next_best_action"],
      "failure_modes": ["lane_unassigned"],
      "next": ["select_theme", "run_evals"]
    },
    {
      "task_id": "select_theme",
      "title": "Select Theme",
      "description": "Polish the operator-facing experience once the corpus is grounded enough to make the product feel real.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["choose_lane_focus"],
      "inputs": ["preset_id", "brand_color", "theme_json"],
      "actions": ["resolve_theme", "validate_contrast", "store_theme_profile"],
      "outputs": ["theme_status", "accessibility_status"],
      "failure_modes": ["theme_invalid", "contrast_failure"],
      "next": ["run_evals"]
    },
    {
      "task_id": "run_evals",
      "title": "Run Evaluation Suite",
      "description": "Benchmark answer quality, corpus coverage, and readiness before go-live.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["choose_lane_focus"],
      "inputs": ["benchmark_count", "workspace_readiness_score"],
      "actions": ["run_benchmarks", "score_readiness", "capture_milestones"],
      "outputs": ["evaluation_status", "readiness_score", "activation_milestones"],
      "failure_modes": ["benchmark_missing", "readiness_too_low"],
      "next": ["configure_governance", "publish_agent"]
    },
    {
      "task_id": "configure_governance",
      "title": "Configure Governance",
      "description": "Set policy packs, retention posture, roles, and audit requirements before rollout.",
      "entry_modes": ["web", "cli"],
      "segments": ["enterprise"],
      "preconditions": ["run_evals"],
      "inputs": ["policy_pack", "retention_rule", "identity_boundary"],
      "actions": ["validate_policy_pack", "capture_retention_settings", "enable_audit_controls"],
      "outputs": ["governance_status", "policy_status"],
      "failure_modes": ["policy_missing", "retention_unset"],
      "next": ["publish_agent"]
    },
    {
      "task_id": "publish_agent",
      "title": "Publish Agent",
      "description": "Confirm go-live readiness and generate the final publish or handoff summary.",
      "entry_modes": ["web", "cli"],
      "segments": ["solo", "business", "enterprise"],
      "preconditions": ["run_evals"],
      "inputs": ["readiness_score", "publish_target"],
      "actions": ["verify_publish_readiness", "capture_publish_summary"],
      "outputs": ["publish_status", "go_live_summary"],
      "failure_modes": ["readiness_too_low", "publish_target_missing"],
      "next": []
    }
  ]
}
