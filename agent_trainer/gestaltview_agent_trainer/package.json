{
  "name": "gestaltview-agent-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone scaffold for the GestaltView Agent Trainer.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "bootstrap:sh": "bash scripts/bootstrap.sh",
    "bootstrap:windows": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "validate-env": "tsx scripts/validate-env.ts",
    "verify-setup": "tsx setup/verify-setup.ts",
    "cli": "tsx scripts/operator-cli.ts",
    "gv": "tsx scripts/operator-cli.ts",
    "apply-pack": "tsx scripts/operator-cli.ts apply",
    "import-template": "tsx scripts/generate-import-template.ts",
    "wizard": "tsx scripts/serve-setup-wizard.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:onboarding": "bash scripts/demo-onboarding.sh",
    "diligence": "bash scripts/run-buyer-diligence.sh",
    "package": "bash scripts/package-kit.sh",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-kit.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^4.0.18"
  }
}
