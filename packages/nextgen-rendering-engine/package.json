{
  "name": "@gestaltview/nextgen-rendering-engine",
  "version": "0.1.0",
  "description": "GestaltView next-generation multi-modal rendering engine integration layer.",
  "type": "module",
  "bin": {
    "gestalt-render": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run build && npm test",
    "inspect": "node dist/cli/index.js inspect --manifest engine.manifest.json"
  },
  "keywords": [
    "gestaltview",
    "rendering",
    "multimodal",
    "scene-graph"
  ],
  "license": "UNLICENSED",
  "types": "./dist/browser.d.ts"
}
